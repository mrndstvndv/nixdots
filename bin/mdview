#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
bun_binary=$(command -v bun || true)

if [ -z "$bun_binary" ]; then
  printf '%s\n' 'mdview: bun is required' >&2
  exit 127
fi

# Bun auto-installs missing imports without consulting this project's lockfile.
# That can select a newer PDFKit release which Bun 1.4 cannot resolve, so
# bootstrap the pinned dependency tree before running the actual program.
if ! "$bun_binary" --no-install --cwd "$project_dir" -e '
  await Promise.all([
    import("docx"),
    import("marked"),
    import("pdfkit"),
  ]);
' >/dev/null 2>&1; then
  printf '%s\n' 'mdview: installing locked dependencies' >&2
  "$bun_binary" install --frozen-lockfile --cwd "$project_dir"
fi

exec "$bun_binary" --no-install "$script_dir/mdview-runtime.js" "$@"
